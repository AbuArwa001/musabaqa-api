{
  "info": {
    "name": "Musabaqa API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth & Registration",
      "item": [
        {
          "name": "Register Institution",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Madrasa\",\n  \"type\": \"MADRASA\",\n  \"contact_person\": \"Sheikh Juma\",\n  \"phone\": \"+254700000000\",\n  \"email\": \"test@madrasa.ke\",\n  \"password\": \"securepassword\",\n  \"region_id\": 1,\n  \"preferred_language\": \"EN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/institutions/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "institutions",
                "register"
              ]
            }
          }
        },
        {
          "name": "Institution Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set(\"access_token\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "nuuralislam@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Inst@2025!",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/institution/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "institution",
                "login"
              ]
            }
          }
        },
        {
          "name": "Staff Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set(\"access_token\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin@jmc.or.ke",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Admin@2025!",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/staff/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "staff",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get My Institution",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/institutions/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "institutions",
                "me"
              ]
            }
          }
        }
      ]
    }
  ]
}
